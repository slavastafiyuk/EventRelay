{
  "realm": "eventrelay",
  "enabled": true,
  "displayName": "EventRelay Development",
  "clients": [
    {
      "clientId": "eventrelay-scalar",
      "name": "EventRelay Scalar",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5000/scalar/",
        "http://localhost:5000/scalar/oauth-test"
      ],
      "webOrigins": [
        "http://localhost:5000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "eventrelay-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "eventrelay-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "developer",
      "enabled": true,
      "email": "dev@eventrelay.local",
      "emailVerified": true,
      "firstName": "EventRelay",
      "lastName": "Developer",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEV_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
