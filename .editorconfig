
# EventRelay - Repository-wide coding conventions

root = true

# General rules for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C# conventions
[*.cs]
indent_size = 4

# Namespaces
csharp_style_namespace_declarations = file_scoped:warning

# Using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace

# var preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Braces
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all

# Modern C#
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# Object initialization
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# Nullability and readability
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_readonly_field = true:suggestion

# XML and .NET project files
[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

# JSON
[*.{json,jsonc}]
indent_size = 2

# YAML (Docker Compose, GitHub Actions, Kubernetes)
[*.{yml,yaml}]
indent_size = 2

# Markdown: preserve intentional trailing spaces
[*.md]
trim_trailing_whitespace = false
