{
  "ReverseProxy": {
    "Routes": {
      "controlPlaneOpenApi": {
        "ClusterId": "controlPlane",
        "Match": {
          "Path": "/docs/specs/controlplane.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      },
      "eventServiceOpenApi": {
        "ClusterId": "events",
        "Match": {
          "Path": "/docs/specs/events.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          }
        ]
      }
    }
  }
}
