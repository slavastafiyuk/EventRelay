{
  "ReverseProxy": {
    "Routes": {
      "controlPlaneRoute": {
        "ClusterId": "controlPlane",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        }
      },
      "eventsRoute": {
        "ClusterId": "events",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "controlPlane": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "events": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102/"
          }
        }
      }
    }
  }
}
